# Get this URI from Atlas > Connect > Drivers. URL-encode the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/signal?retryWrites=true&w=majority
MONGODB_DB_NAME=signal
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters-long
PORT=3001
NODE_ENV=development
# Comma-separated browser origins; server-to-server requests do not need CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only to the number of reverse proxies you control (normally 1 on a host).
TRUST_PROXY_HOPS=0
