{
  "name": "signal-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/*.test.js",
    "export": "expo export --platform android --platform ios",
    "build:apk": "node scripts/build-release.mjs",
    "updates:configure": "node scripts/configure-updates.mjs"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
